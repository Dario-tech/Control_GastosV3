
# --- Desarrollo local contra la BD de QA (copia este fichero a backend/.env; main.py lo carga solo) ---
# Sustituye [YOUR-PASSWORD] por la contraseña real. NUNCA la subas a git.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.qmqseibceutmczfggelx.supabase.co:5432/postgres
# Debe ser LA MISMA clave con la que se sembró la BD de QA (si no, no se descifran los datos)
DB_ENCRYPTION_KEY=
JWT_SECRET=

# Registro de usuarios NUEVOS (POST /api/auth/register y primer login con Google).
# Por defecto está CERRADO (403 "El registro está cerrado..."); los usuarios que ya
# existen entran igual. Descomenta SOLO si quieres abrir el alta (true/1/yes).
# En producción y QA déjalo sin definir.
# ALLOW_REGISTER=true

# /docs, /redoc y /openapi.json están apagados por defecto. Descomenta para
# desarrollo local (true/1/yes); no lo actives en producción.
# ENABLE_DOCS=true
